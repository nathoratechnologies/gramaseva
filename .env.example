# Firebase console → Project settings → Your apps → Web app → "firebaseConfig"
# ഈ file-ന്റെ ഒരു copy ".env" എന്ന പേരിൽ ഉണ്ടാക്കി താഴെയുള്ള values നിറയ്ക്കുക.
# Values ഒഴിഞ്ഞുകിടന്നാൽ app "Demo mode"-ൽ പ്രവർത്തിക്കും (sample data, യഥാർത്ഥ OTP ഇല്ല).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Free WhatsApp login server (whatsapp-login/README.md). Empty = WhatsApp button hidden.
VITE_WA_LOGIN_URL=

# Firebase SMS OTP login (needs the Blaze billing plan). 1 = show "phone number + OTP" on the login screen.
VITE_PHONE_OTP=
